{
  "name": "ts-scan",
  "version": "0.0.1",
  "description": "A tool to analyze TypeScript code",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "API",
    "endpoint",
    "analysis",
    "typescript",
    "static-analysis"
  ],
  "author": "Takahito Mita",
  "license": "MIT",
  "private": true,
  "dependencies": {
    "@reduxjs/toolkit": "^2.6.1",
    "axios": "^1.8.3",
    "chalk": "^4.1.2",
    "commander": "^9.4.0",
    "glob": "^8.0.3",
    "ts-morph": "^16.0.0"
  },
  "devDependencies": {
    "@types/glob": "^8.0.0",
    "@types/jest": "^29.2.0",
    "@types/node": "^18.11.0",
    "@typescript-eslint/eslint-plugin": "^5.40.1",
    "@typescript-eslint/parser": "^5.40.1",
    "eslint": "^8.25.0",
    "jest": "^29.2.1",
    "prettier": "^2.7.1",
    "ts-jest": "^29.0.3",
    "ts-mockito": "^2.6.1",
    "ts-node": "^10.9.1",
    "typescript": "^4.8.4"
  }
}
