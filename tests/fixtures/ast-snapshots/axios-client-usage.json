  "fileName": "axios-client-usage.ts",
  "text": "import axios from 'axios';\n\n/**\n * ユーザーデータを取得する関数\n * @param userId ユーザーID\n * @returns ユーザー情報\n */\nasync function fetchUserData(userId: string) {\n  try {\n    const response = await axios.get(`/api/users/${userId}`);\n    return response.data;\n  } catch (error) {\n    console.error('Error fetching user data:', error);\n    throw error;\n  }\n}\n\n/**\n * 新しいユーザーを作成する関数\n * @param userData ユーザーデータ\n * @returns 作成されたユーザー情報\n */\nasync function createUser(userData: { name: string; email: string }) {\n  try {\n    const response = await axios.post('/api/users', userData);\n    return response.data;\n  } catch (error) {\n    console.error('Error creating user:', error);\n    throw error;\n  }\n}\n\n/**\n * ユーザー情報を更新する関数\n * @param userId ユーザーID\n * @param userData 更新するユーザーデータ\n * @returns 更新されたユーザー情報\n */\nasync function updateUser(userId: string, userData: Partial<{ name: string; email: string }>) {\n  try {\n    const response = await axios.put(`/api/users/${userId}`, userData);\n    return response.data;\n  } catch (error) {\n    console.error('Error updating user:', error);\n    throw error;\n  }\n}\n\nexport { fetchUserData, createUser, updateUser };\n",
